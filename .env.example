# ==========================================
# LectureNote AI Environment Configuration
# ==========================================

# Database (PostgreSQL)
POSTGRES_DB=lecturenote
POSTGRES_USER=lecturenote
POSTGRES_PASSWORD=lecturenote
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lecturenote

# Backend (Spring Boot :8080)
SERVER_PORT=8080
STT_WORKER_URL=http://localhost:8000
STT_CALLBACK_URL=http://localhost:8080/internal/stt/callback
STT_SHARED_SECRET=lecturenote-secret-token-change-in-prod
STORAGE_AUDIO_DIR=./storage/audio

# STT Worker (FastAPI :8000)
STT_PORT=8000
STT_MODEL_SIZE=large-v3-turbo
STT_DEVICE=cuda
STT_COMPUTE_TYPE=float16

# LLM (Ollama :11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=exaone3.5:2.4b
OLLAMA_NUM_CTX=8192

# Frontend (Vite :5173)
VITE_API_BASE_URL=http://localhost:8080
